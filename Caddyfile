{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv

	# form handler (server/api.mjs)
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:3001
	}
	encode zstd gzip

	# old Wix duplicate page
	redir /copy-of-pvc-deck-carp /pvc-deck-carp 301
	redir /welness /wellness 301

	# one URL per page: drop trailing slash and .html, like the Wix URLs
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1} 301
	@html path_regexp html ^(.+)/index\.html$
	redir @html {re.html.1} 301

	header /img/* Cache-Control "public, max-age=31536000, immutable"
	header /media/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/* Cache-Control "public, max-age=86400"

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server {
			status 404
		}
	}
}
